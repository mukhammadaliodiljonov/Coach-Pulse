<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-add-user-password-hash" author="coach-pulse">
        <!-- Existing accounts predate password authentication, so their hashes remain null. -->
        <addColumn tableName="users">
            <column name="password_hash" type="VARCHAR(255)"/>
        </addColumn>

        <!-- Email addresses are normalized on registration; this also protects against races. -->
        <sql>CREATE UNIQUE INDEX uq_users_email_lower ON users (LOWER(email))</sql>
        <rollback>
            <sql>DROP INDEX uq_users_email_lower</sql>
            <dropColumn tableName="users" columnName="password_hash"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
