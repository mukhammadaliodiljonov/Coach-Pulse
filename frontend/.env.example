# Copy to .env.local to override locally (.local files are git-ignored).

# Where the app gets its data: "mock" (sample data, the default) or "api" (the Spring Boot backend).
# `npm run dev:api` sets this to "api" for you (see .env.api).
VITE_DATA_SOURCE=mock

# Base URL for API requests. Keep /api in development — the dev server proxies it.
# Set a full URL (e.g. https://api.example.com/api) when the API is on another origin.
VITE_API_BASE_URL=/api

# Where the dev server sends /api requests.
API_PROXY_TARGET=http://localhost:8080
